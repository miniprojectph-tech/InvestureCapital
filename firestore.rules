rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // === Users ===
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Sign-up writes the STARTER record only: no admin flag, no money, no
      // placements, no sponsor. (A member could otherwise create — or delete and
      // re-create — their record as an admin with any balance.) Owners can't
      // delete their record at all.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('placements', []).size() == 0
        && request.resource.data.get('completedPlacements', []).size() == 0
        && request.resource.data.get('activePlans', []).size() == 0
        && request.resource.data.get('completedPlans', []).size() == 0
        && !('fastStart' in request.resource.data)
        && !('referredByUserId' in request.resource.data)
        && !('payoutMethod' in request.resource.data)
        && request.resource.data.get('balances', {}).get('wallet', 0) == 0
        && request.resource.data.get('balances', {}).get('vault', 0) == 0
        && request.resource.data.get('referralWallet', {}).get('available', 0) == 0
        && request.resource.data.get('referralWallet', {}).get('pending', 0) == 0
        && request.resource.data.get('referralWallet', {}).get('locked', 0) == 0
        && request.resource.data.get('referralWallet', {}).get('totalEarned', 0) == 0
        && request.resource.data.get('referralWallet', {}).get('totalWithdrawn', 0) == 0;

      // The owner may change ONLY: profile details, payout method, their referral
      // code, and their sponsor (once). Balances, placements, commissions and the
      // admin flag are written by Cloud Functions alone.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['profile', 'payoutMethod', 'referralCode', 'referredByUserId', 'emailOptOut'])
        // marketing email preference: a plain on/off
        && request.resource.data.get('emailOptOut', false) is bool
        // sign-up date and email are fixed
        && request.resource.data.get('profile', {}).get('joinedAt', null) == resource.data.get('profile', {}).get('joinedAt', null)
        && request.resource.data.get('profile', {}).get('email', null) == resource.data.get('profile', {}).get('email', null)
        // a referral code is chosen once
        && (request.resource.data.get('referralCode', null) == resource.data.get('referralCode', null)
            || resource.data.get('referralCode', null) == null)
        // a sponsor is attached once, and never yourself
        && (request.resource.data.get('referredByUserId', null) == resource.data.get('referredByUserId', null)
            || (resource.data.get('referredByUserId', null) == null
                && request.resource.data.referredByUserId is string
                && request.resource.data.referredByUserId != request.auth.uid));

      allow read, write: if isAdmin();

      // Transaction history: the owner reads it; only Functions and admins write
      // it, so a member can't invent or erase entries.
      match /activity/{activityId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }

      // Reef game state — owner can read; writes only via Cloud Functions
      // (admin SDK bypasses rules) so points/energy can't be forged client-side.
      match /game/{doc} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }

      // Notifications — written by Cloud Functions; the owner may only flip `read`.
      match /notifications/{nId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow read, write: if isAdmin();
      }
    }

    // === Test clocks: accounts an admin put on accelerated time ===
    // Deliberately NOT on the user doc (members can edit that) — otherwise a
    // member could speed up their own payouts. The owner may read theirs so the
    // app can show the "test clock" chip; only admins/functions write.
    match /test_clocks/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // === Compensation plan: commission / bonus ledger (Functions write) ===
    match /commissions/{cId} {
      allow read: if isSignedIn()
        && (resource.data.toUserId == request.auth.uid
            || resource.data.fromUserId == request.auth.uid
            || isAdmin());
      allow write: if isAdmin();
    }

    // === Reef: fish catalog (admin-managed, readable by all signed-in) ===
    match /fish/{fishId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // === Reef: reward catalog ===
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // === Reef: redemption requests (created via Cloud Functions) ===
    match /redemptions/{rId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // === Reef: leaderboard (written by Cloud Functions) ===
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === Reef: global game docs e.g. fish of the hour (written by functions) ===
    match /games/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === Plans (admin-managed templates, readable by all signed-in users) ===
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // === Withdrawal requests ===
    // Created ONLY by the requestWithdrawal function, which debits the wallet and
    // files the request in one transaction. (A member-created request used to be
    // refundable on rejection without ever having been debited.)
    match /withdrawals/{wId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // === Top-up requests (legacy — no member screen files these any more) ===
    match /topups/{tId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // === Plan activation requests ===
    // The member files a payment proof; only these fields, a sane amount, and a
    // receipt that lives in their own receipts folder.
    match /plan_requests/{rId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'amount', 'termMonths',
             'planName', 'method', 'methodLabel', 'referenceNumber', 'receiptUrl', 'receiptPath', 'status', 'createdAt'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000
        && request.resource.data.termMonths is int
        && request.resource.data.termMonths > 0
        && request.resource.data.get('userName', '') is string && request.resource.data.get('userName', '').size() <= 80
        && request.resource.data.get('referenceNumber', '') is string && request.resource.data.get('referenceNumber', '').size() <= 80
        // Proof of payment is REQUIRED: an uploaded receipt in the member's own folder.
        && request.resource.data.receiptUrl is string
        && request.resource.data.receiptUrl.size() > 0 && request.resource.data.receiptUrl.size() <= 1000
        && request.resource.data.receiptPath is string
        && request.resource.data.receiptPath.matches('^receipts/' + request.auth.uid + '/[^/]+$');
      allow update, delete: if isAdmin();
    }

    // === Limited events (slot boosts / referral multipliers) ===
    // Members see live events; admins see all. Every write goes through Functions.
    match /events/{eventId} {
      allow read: if isSignedIn() && (resource.data.status == 'live' || isAdmin());
      allow write: if false;
      match /claims/{claimId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
      // Spin the wheel: window ledgers are public to members (the pool bar),
      // a member reads only their own spin state and spins; admins see all.
      match /windows/{windowId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
      match /spinners/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
      match /spins/{spinId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // === Platform settings (readable by all signed-in, writable by admin) ===
    match /settings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === Email campaign log (written by the send function) ===
    match /email_campaigns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === Admin-only records (exchange credentials etc.) — never readable by members ===
    match /admin_private/{doc} {
      allow read, write: if isAdmin();
    }

    // === Audit trail written by admin Functions ===
    match /admin_audit/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === Editable content (Help & FAQ) ===
    // content/faq is the whole FAQ in one document (one read per visit);
    // content/faqVotes holds helpful counts, written only by the faqVote function.
    match /content/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && doc != 'faqVotes';
    }
    // A member's own FAQ votes (written by the faqVote function).
    match /faq_voters/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // === Referral code index (code -> uid) ===
    // Publicly readable by signed-in users so a new signup can resolve ?ref=CODE
    // to the referrer's uid (they can't query the users collection). A user may
    // only claim a code that points at their own uid, and never overwrite one.
    match /referralCodes/{code} {
      // Look up ONE code; only admins can list the whole code → member index.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && code.size() >= 4 && code.size() <= 24;
      allow update, delete: if isAdmin();
    }

    // === Referral transactions (the affiliate ledger) ===
    // The referred user files a 'queued' claim for their own activation; a Cloud
    // Function (admin SDK, bypasses rules) validates it and credits the referrer.
    // Both parties can read their own rows; only admins/functions mutate.
    match /referral_transactions/{txnId} {
      allow read: if isSignedIn()
        && (resource.data.referrerUserId == request.auth.uid
            || resource.data.referredUserId == request.auth.uid
            || isAdmin());
      // Legacy one-level system: nothing files claims from the app any more
      // (commissions are paid by activatePlacement), so members can't create rows.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // === Community Tongits: rooms (Phase 1) ===
    // Public lobby → any signed-in user can read. All mutations go through Cloud
    // Functions (admin SDK bypasses rules); direct client writes are denied.
    match /game_rooms/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Public game state — room members read; Functions write.
      match /game/{doc} {
        allow read: if isSignedIn()
          && (isAdmin()
              || get(/databases/$(database)/documents/game_rooms/$(code)).data.players[request.auth.uid] != null);
        allow write: if isAdmin();
      }

      // Private hands — only the owning player can read their own cards.
      match /hands/{playerId} {
        allow read: if isSignedIn() && (request.auth.uid == playerId || isAdmin());
        allow write: if isAdmin();
      }

      // Hidden deck/stock — never client-readable (Functions/admin only).
      match /secret/{doc} {
        allow read, write: if isAdmin();
      }

      // Chat: only players listed in the room may post/read; messages are
      // author-stamped and length-limited. Reads limited to room members.
      match /chat/{msgId} {
        allow read: if isSignedIn()
          && (isAdmin()
              || get(/databases/$(database)/documents/game_rooms/$(code)).data.players[request.auth.uid] != null);
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 300
          && get(/databases/$(database)/documents/game_rooms/$(code)).data.players[request.auth.uid] != null
          && get(/databases/$(database)/documents/game_rooms/$(code)).data.chatEnabled == true;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // === Community Tongits: chat reports (players file, admins moderate) ===
    match /game_chat_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // === Community Tongits: player reports (players file, admins moderate) ===
    match /game_player_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // === Community Tongits: point transaction ledger (Functions write) ===
    match /game_point_transactions/{txnId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // === Community Tongits: leaderboard (Functions write, public read) ===
    match /tongits_leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === Community Tongits: match records (Functions write) ===
    match /game_matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /game_match_results/{resultId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // === collectionGroup('activity') reads — admins only across all users ===
    match /{path=**}/activity/{activityId} {
      allow read: if isAdmin();
    }

    // === collectionGroup('game') reads — admins only (per-investor game admin) ===
    match /{path=**}/game/{gameDoc} {
      allow read: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
