rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = whitelisted console emails OR the app's Firestore isAdmin flag.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'miniprojectph@gmail.com' ||
        request.auth.token.email == 'danzbusiness2019@gmail.com' ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // ===== existing project paths =====
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    match /branding/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /mop/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /logo5.png {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /profile-placeholder.png {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== Investure app: Reef game + payments =====
    match /game-assets/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*'));
    }
    match /fish/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /rewards/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /payment-methods/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /receipts/{userId}/{file} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ===== Community chat media =====
    // Clients compress images on-device before upload; the 15 MB cap covers
    // admin originals. Video uploads are admin-only.
    // Community Room uploads. Who may send pictures and video is an admin toggle in
    // settings/platform.community (defaults: pictures yes, video admins + moderators).
    // A moderator is flagged on their own member record (isChatMod). Storage rules
    // seem to allow only a couple of distinct Firestore documents per request, so
    // this reuses the record isAdmin() already reads instead of a separate list.
    function isChatMod() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isChatMod', false) == true;
    }
    // The toggles may be missing or null (never set) — then the default applies.
    function settingsData() {
      return firestore.get(/databases/(default)/documents/settings/platform).data;
    }
    function communityAllows(key, dflt) {
      return ('community' in settingsData() && settingsData().community is map)
        ? settingsData().community.get(key, dflt) == true
        : dflt;
    }
    // Admin-set size caps (MB) per chat: settings/platform.uploads.{room,inbox}.
    // Missing or odd values fall back to 15 MB; nothing may exceed 200 MB.
    function uploadCfg(chat) {
      return ('uploads' in settingsData() && settingsData().uploads is map && settingsData().uploads.get(chat, {}) is map)
        ? settingsData().uploads.get(chat, {})
        : {};
    }
    function capBytes(chat, key) {
      return (uploadCfg(chat).get(key, 15) is number && uploadCfg(chat).get(key, 15) >= 1 && uploadCfg(chat).get(key, 15) <= 200)
        ? uploadCfg(chat).get(key, 15) * 1024 * 1024
        : 15 * 1024 * 1024;
    }
    match /community/{userId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < capBytes('room', 'imageMB'))
          || (request.resource.contentType.matches('video/.*') && request.resource.size < capBytes('room', 'videoMB'))
        )
        && (
          // Order matters: once a firestore.exists() comes back "not found", every later
          // Firestore lookup in the same request is denied — so the settings are read
          // BEFORE the moderator check, which only runs when the settings say no.
          (request.resource.contentType.matches('image/.*')
            && (isAdmin() || communityAllows('membersImages', true) || isChatMod()))
          || (request.resource.contentType.matches('video/.*')
            && (isAdmin() || communityAllows('membersVideo', false) || (isChatMod() && communityAllows('modsVideo', true))))
        );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Private admin chat uploads: members send pictures; staff also video. Own caps.
    match /inbox/{userId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < capBytes('inbox', 'imageMB'))
          || (request.resource.contentType.matches('video/.*') && request.resource.size < capBytes('inbox', 'videoMB')
              && (isAdmin() || isChatMod()))
        );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ===== Help & FAQ media (admin uploads; members read) =====
    match /faq/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*'));
      allow delete: if isAdmin();
    }

    // ===== Event banners (admin uploads; members read) =====
    match /events/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // ===== catch-all (keep last) =====
    // Admins only. Storage rules are OR-ed across matching blocks, so a
    // "signed-in can read" here used to override the owner-only rule on
    // receipts and let any member list and download everyone's payment proofs.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
